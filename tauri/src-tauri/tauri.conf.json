{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Artemis Paysages Enregistreur V2",
  "mainBinaryName": "Artemis Paysages Enregistreur V2",
  "identifier": "com.artemis-paysages.enregistreur.v2",
  "version": "0.2.0-beta.1",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/app-icon.png"
    ],
    "copyright": "© Artemis Paysages. L'art d'embellir vos extérieurs.",
    "category": "Productivity",
    "shortDescription": "Artemis Paysages — Enregistreur de réunion",
    "longDescription": "Artemis Paysages Enregistreur de réunion : capture, transcrit et analyse vos rendez-vous commerciaux avec profilage ProcessCom. Entièrement local pour vos données sensibles.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "startMenuFolder": "Artemis Paysages"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
